+@pytest.mark.parametrize("service_type", service_types)
+def test_dynamic_config_tracks_connected_ports(
+    service_type: iox2.ServiceType,
+) -> None:
+    config = iox2.testing.generate_isolated_config()
+    node = iox2.NodeBuilder.new().config(config).create(service_type)
+
+    service_name = iox2.testing.generate_service_name()
+    service = (
+        node.service_builder(service_name).publish_subscribe(Payload).create()
+    )
+
+    assert service.dynamic_config.number_of_publishers == 0
+    assert service.dynamic_config.number_of_subscribers == 0
+
+    publisher = service.publisher_builder().create()
+    subscriber = service.subscriber_builder().create()
+
+    assert service.dynamic_config.number_of_publishers == 1
+    assert service.dynamic_config.number_of_subscribers == 1
+
+    publishers = service.dynamic_config.list_publishers()
+    assert len(publishers) == 1
+    assert publishers[0].publisher_id == publisher.id
+    assert publishers[0].node_id == node.id
+
+    subscribers = service.dynamic_config.list_subscribers()
+    assert len(subscribers) == 1
+    assert subscribers[0].subscriber_id == subscriber.id
+    assert subscribers[0].node_id == node.id
+    assert subscribers[0].buffer_size == subscriber.buffer_size
+
+    publisher.delete()
+    subscriber.delete()
+
+    assert service.dynamic_config.number_of_publishers == 0
+    assert service.dynamic_config.number_of_subscribers == 0
