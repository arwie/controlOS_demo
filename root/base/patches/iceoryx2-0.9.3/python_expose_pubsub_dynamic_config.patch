+#[pyclass]
+/// Contains the communication settings of a connected `Publisher`.
+pub struct PublisherDetails(
+    pub(crate) iceoryx2::service::dynamic_config::publish_subscribe::PublisherDetails,
+);
+
+#[pymethods]
+impl PublisherDetails {
+    #[getter]
+    /// The `UniquePublisherId` of the `Publisher`.
+    pub fn publisher_id(&self) -> UniquePublisherId {
+        UniquePublisherId(self.0.publisher_id)
+    }
+
+    #[getter]
+    /// The `UniqueNodeId` of the `Node` under which the `Publisher` was created.
+    pub fn node_id(&self) -> UniqueNodeId {
+        UniqueNodeId(self.0.node_id)
+    }
+
+    #[getter]
+    /// The total number of samples contained in the `Publisher`s data segment.
+    pub fn number_of_samples(&self) -> usize {
+        self.0.number_of_samples
+    }
+
+    #[getter]
+    /// The current maximum length of a slice.
+    pub fn max_slice_len(&self) -> usize {
+        self.0.max_slice_len
+    }
+}
+
+#[pyclass]
+/// Contains the communication settings of a connected `Subscriber`.
+pub struct SubscriberDetails(
+    pub(crate) iceoryx2::service::dynamic_config::publish_subscribe::SubscriberDetails,
+);
+
+#[pymethods]
+impl SubscriberDetails {
+    #[getter]
+    /// The `UniqueSubscriberId` of the `Subscriber`.
+    pub fn subscriber_id(&self) -> UniqueSubscriberId {
+        UniqueSubscriberId(self.0.subscriber_id)
+    }
+
+    #[getter]
+    /// The `UniqueNodeId` of the `Node` under which the `Subscriber` was created.
+    pub fn node_id(&self) -> UniqueNodeId {
+        UniqueNodeId(self.0.node_id)
+    }
+
+    #[getter]
+    /// The size of the receive buffer that stores `Sample`s.
+    pub fn buffer_size(&self) -> usize {
+        self.0.buffer_size
+    }
+}
+
+#[pyclass]
+/// The dynamic configuration of a `MessagingPattern::PublishSubscribe` based `Service`.
+/// Contains dynamic parameters like the connected endpoints etc..
+pub struct DynamicConfigPublishSubscribe(pub(crate) Parc<PortFactoryPublishSubscribeType>);
+
+#[pymethods]
+impl DynamicConfigPublishSubscribe {
+    #[getter]
+    /// Returns how many `Publisher` ports are currently connected.
+    pub fn number_of_publishers(&self) -> usize {
+        match &*self.0.lock() {
+            PortFactoryPublishSubscribeType::Ipc(v) => v.dynamic_config().number_of_publishers(),
+            PortFactoryPublishSubscribeType::Local(v) => v.dynamic_config().number_of_publishers(),
+        }
+    }
+
+    #[getter]
+    /// Returns how many `Subscriber` ports are currently connected.
+    pub fn number_of_subscribers(&self) -> usize {
+        match &*self.0.lock() {
+            PortFactoryPublishSubscribeType::Ipc(v) => v.dynamic_config().number_of_subscribers(),
+            PortFactoryPublishSubscribeType::Local(v) => v.dynamic_config().number_of_subscribers(),
+        }
+    }
+
+    /// Returns the `PublisherDetails` of all connected `Publisher` ports.
+    pub fn list_publishers(&self) -> Vec<PublisherDetails> {
+        let mut ret_val = vec![];
+        match &*self.0.lock() {
+            PortFactoryPublishSubscribeType::Ipc(v) => {
+                v.dynamic_config().list_publishers(|details| {
+                    ret_val.push(PublisherDetails(*details));
+                    CallbackProgression::Continue
+                })
+            }
+            PortFactoryPublishSubscribeType::Local(v) => {
+                v.dynamic_config().list_publishers(|details| {
+                    ret_val.push(PublisherDetails(*details));
+                    CallbackProgression::Continue
+                })
+            }
+        }
+        ret_val
+    }
+
+    /// Returns the `SubscriberDetails` of all connected `Subscriber` ports.
+    pub fn list_subscribers(&self) -> Vec<SubscriberDetails> {
+        let mut ret_val = vec![];
+        match &*self.0.lock() {
+            PortFactoryPublishSubscribeType::Ipc(v) => {
+                v.dynamic_config().list_subscribers(|details| {
+                    ret_val.push(SubscriberDetails(*details));
+                    CallbackProgression::Continue
+                })
+            }
+            PortFactoryPublishSubscribeType::Local(v) => {
+                v.dynamic_config().list_subscribers(|details| {
+                    ret_val.push(SubscriberDetails(*details));
+                    CallbackProgression::Continue
+                })
+            }
+        }
+        ret_val
+    }
+}
