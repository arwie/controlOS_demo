+    #[getter]
+    /// Returns the underlying `FileDescriptor` of the `Listener`. It becomes ready to read
+    /// whenever an `EventId` was notified, so it can be attached to an external event loop,
+    /// for instance via `asyncio.AbstractEventLoop.add_reader()`.
+    ///
+    /// The returned `FileDescriptor` is non-owning, the `Listener` keeps the ownership. It
+    /// must no longer be used after `Listener::delete()` was called.
+    pub fn file_descriptor(&self) -> FileDescriptor {
+        let native_handle = match &self.0 {
+            ListenerType::Ipc(Some(v)) => unsafe { v.file_descriptor().native_handle() },
+            ListenerType::Local(Some(v)) => unsafe { v.file_descriptor().native_handle() },
+            _ => fatal_panic!(from "Listener::file_descriptor()",
+                    "Accessing a released listener."),
+        };
+
+        FileDescriptor(Arc::new(
+            iceoryx2::prelude::FileDescriptor::non_owning_new(native_handle).unwrap_or_else(
+                || fatal_panic!(from "Listener::file_descriptor()",
+                        "This should never happen! The listener has an invalid file descriptor."),
+            ),
+        ))
+    }
